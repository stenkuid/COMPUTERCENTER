---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Komponen PC, accessories, dan jasa rakit ahli untuk membantu kamu membangun komputer impian yang sesuai kebutuhan dan budget." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <div class="container nav-wrap">
        <a href="/" class="logo">COMPUTERCENTER</a>
        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="#menu">Katalog</a>
          <a href="#lokasi">Lokasi</a>
          <a href="/admin" style="font-weight:700; color:var(--accent);">Admin Login</a>
          <a href="https://wa.me/?text=Halo%20COMPUTERCENTER" class="btn" target="_blank">Order via WA</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; 2026 COMPUTERCENTER. All rights reserved. | <a href="/admin">Dashboard Admin</a> | Hosted on Cloudflare Pages (https://computercenter.pages.dev)</p>
      </div>
    </footer>
  </body>
</html>
