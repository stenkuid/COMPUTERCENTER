---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Pusat Rakit PC Gaming & Workstation Terpercaya" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="header">
      <div class="container nav-content">
        <a href="/" class="logo">
          ⚙️ Computer Center
        </a>
        <ul class="nav-links">
          <li><a href="#katalog">Katalog & Menu</a></li>
          <li><a href="#keunggulan">Keunggulan</a></li>
          <li><a href="#kontak">Kontak</a></li>
        </ul>
        <a href="https://wa.me/6281234567890" target="_blank" class="btn-cta">
          Hubungi Kami
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Computer Center. Made by Stenku.</p>
      </div>
    </footer>
  </body>
</html>
