---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Komponen PC original, accessories terlengkap, dan jasa rakit ahli bergaransi untuk membantu kamu membangun komputer impian yang presisi." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body>
    <header id="site-header">
      <div class="container nav-wrap">
        <a href="/" class="logo">
          <span class="logo-text">COMPUTERCENTER</span>
          <span class="logo-dot">.</span>
        </a>
        <nav class="nav-links">
          <a href="#" class="nav-item">Beranda</a>
          <a href="#katalog" class="nav-item">Katalog & Produk</a>
          <a href="#keunggulan" class="nav-item">Keunggulan</a>
          <a href="#lokasi" class="nav-item">Kontak</a>
          <a href="https://wa.me/?text=Halo%20COMPUTERCENTER,%20saya%20tertarik%20dengan%20produk%20layanan%20Anda" class="btn nav-btn" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Order WA</span>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo footer-logo">COMPUTERCENTER<span class="logo-dot">.</span></a>
          <p class="footer-desc">Komponen PC original, accessories terlengkap, dan jasa rakit ahli bergaransi untuk membantu kamu membangun komputer impian yang presisi.</p>
        </div>
        <div class="footer-nav">
          <h4 class="footer-heading">Navigasi</h4>
          <a href="#">Beranda</a>
          <a href="#katalog">Katalog Produk</a>
          <a href="#keunggulan">Keunggulan Utama</a>
          <a href="#lokasi">Kontak & Lokasi</a>
        </div>
        <div class="footer-contact">
          <h4 class="footer-heading">Layanan & Kontak</h4>
          <p>Buka Setiap Hari: 08:00 - 21:00 WIB</p>
          <p class="footer-highlight">Layanan Pelanggan WhatsApp Aktif</p>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>&copy; {new Date().getFullYear()} COMPUTERCENTER. Made by Stenku.</p>
      </div>
    </footer>

    <script>
      const header = document.getElementById('site-header');
      const handleScroll = () => {
        if (window.scrollY > 30) {
          header?.classList.add('scrolled');
        } else {
          header?.classList.remove('scrolled');
        }
      };
      window.addEventListener('scroll', handleScroll);
      handleScroll();
    </script>
  </body>
</html>
