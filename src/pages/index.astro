---
import Layout from '../layouts/Layout.astro';

const items = [{"name": "Pro Build Gaming Setup", "price": "Rp 12.500.000", "desc": "Rakit PC Gaming Ryzen/Core + RTX Series siap libas game AAA 1080p/1440p lancar jaya.", "img": "https://images.unsplash.com/photo-1587202372775-e229f172b9d7?w=500&q=80", "badge": "GAMING"}, {"name": "Creator Workstation 4K", "price": "Rp 18.900.000", "desc": "Performa kencang 32GB RAM & High-speed NVMe SSD untuk rendering video 4K & 3D cepat.", "img": "https://images.unsplash.com/photo-1591799264318-7e6ef8ddb7ea?w=500&q=80", "badge": "CREATOR"}, {"name": "Office & Student Compact PC", "price": "Rp 4.500.000", "desc": "PC hemat daya, efisien, dan responsif untuk tugas komputasi harian dan olah data.", "img": "https://images.unsplash.com/photo-1547082297-d19818e69772?w=500&q=80", "badge": "OFFICE"}, {"name": "Custom Liquid Cooled Rig", "price": "Rp 28.000.000", "desc": "Sistem pendingin cairan kustom dengan performa ekstrim dan pencahayaan RGB memukau.", "img": "https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=500&q=80", "badge": "ULTIMATE"}];
const features = [{"icon": "\u2699\ufe0f", "title": "Management Kabel Rapi", "desc": "Penataan kabel profesional presisi tinggi untuk sirkulasi udara optimal dan visual estetis."}, {"icon": "\ud83e\uddea", "title": "Stress Test 24 Jam", "desc": "Setiap unit PC rakitan diuji stabilitas suhu dan performa komputasinya sebelum diserahkan."}, {"icon": "\ud83d\udee1\ufe0f", "title": "Garansi Resmi Distributor", "desc": "Semua suku cadang dipastikan 100% baru dan terlindungi garansi resmi nasional."}];
const stats = [{"num": "4.9 \u2605", "label": "Rating Pelanggan"}, {"num": "100%", "label": "Hardware Original"}, {"num": "1 Tahun", "label": "Garansi Rakit Studio"}];
---

<Layout title="Computer Center — PC Parts & Custom PC Build">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-badge">
        <span>🖥️ Custom Build & Hardware Specialists</span>
      </div>
      <h1 class="hero-title">
        Build Your PC. Your Way.<br />
        <span class="text-gradient-accent">Kualitas Impeccable Terbaik.</span>
      </h1>
      <p class="hero-desc">
        Komponen PC original, accessories terlengkap, dan jasa rakit ahli bergaransi untuk membantu kamu membangun komputer impian yang presisi.
      </p>

      <div class="hero-buttons">
        <a href="#katalog" class="btn">
          <span>Jelajahi Katalog</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="https://wa.me/?text=Halo%20COMPUTERCENTER,%20saya%20mau%20konsultasi%20order" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Pesan via WhatsApp</span>
        </a>
      </div>

      <div class="hero-stats">
        {stats.map((s) => (
          <div class="stat-item">
            <h3>{s.num}</h3>
            <p>{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Keunggulan Section -->
  <section id="keunggulan" class="section container">
    <div class="section-header">
      <p class="section-subtitle">MENGAPA MEMILIH KAMI</p>
      <h2 class="section-title">Keunggulan Utama COMPUTERCENTER</h2>
    </div>
    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon">{f.icon}</div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Katalog Section -->
  <section id="katalog" class="section container">
    <div class="section-header">
      <p class="section-subtitle">PILIHAN TERBAIK</p>
      <h2 class="section-title">Katalog Produk & Layanan Unggulan</h2>
    </div>
    <div class="cards-grid">
      {items.map((item) => (
        <div class="card">
          <div class="card-img-wrap">
            <img src={item.img} alt={item.name} class="card-img" />
            <span class="badge">{item.badge}</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">{item.name}</h3>
            <p class="card-desc">{item.desc}</p>
            <div class="card-footer">
              <span class="card-price">{item.price}</span>
              <a href={`https://wa.me/?text=Halo%20COMPUTERCENTER,%20saya%20tertarik%20order%20${encodeURIComponent(item.name)}`} class="btn btn-card" target="_blank" rel="noopener noreferrer">
                <span>Pesan</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Box Section -->
  <section id="lokasi" class="container">
    <div class="cta-box">
      <div class="cta-content">
        <h2 class="cta-title">Siap Menikmati Layanan Terbaik dari COMPUTERCENTER?</h2>
        <p class="cta-desc">Hubungi tim kami via WhatsApp resmi untuk konsultasi gratis, tanya jawab produk, atau pemesanan cepat hari ini.</p>
        <a href="https://wa.me/?text=Halo%20COMPUTERCENTER" class="btn" style="padding: 1rem 2.5rem; font-size: 1.1rem;" target="_blank" rel="noopener noreferrer">
          <span>Hubungi Kami Sekarang</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
