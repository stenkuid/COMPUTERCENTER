---
import Layout from '../layouts/Layout.astro';

const stats = [{'val': '100%', 'lbl': 'Garansi Resmi Distributor'}, {'val': 'Free', 'lbl': 'Jasa Rakit & Cable Management'}, {'val': '24 Jam', 'lbl': 'Stress Test Benchmark'}, {'val': '1.500+', 'lbl': 'PC Berhasil Dirakit'}];
const items = [{'name': 'Rig Tier 1: Esports Gaming 1080p', 'desc': 'Intel Core i5 13400F + RTX 4060 8GB, 16GB DDR5 RAM, 1TB NVMe Gen4.', 'price': 'Rp 11.500.000', 'tag': 'Best Value'}, {'name': 'Rig Tier 2: Creator 4K & Rendering', 'desc': 'AMD Ryzen 7 7800X3D + RTX 4070 Ti Super 16GB, 32GB DDR5, 2TB Gen4 SSD.', 'price': 'Rp 24.800.000', 'tag': 'High Performance'}, {'name': 'Rig Tier 3: Office & Admin Streamlined', 'desc': 'Intel Core i3 12100 + UHD Graphics, 8GB DDR4, 512GB SSD, Casing Compact.', 'price': 'Rp 4.900.000', 'tag': 'Budget Friendly'}, {'name': 'Monitor Gaming 27" IPS 180Hz', 'desc': 'Resolusi FHD 1ms response time, HDR10, sRGB 99% color gamut.', 'price': 'Rp 2.150.000', 'tag': 'Peripheral'}];
const features = [{'icon': '🔌', 'title': 'Cable Management Rapi', 'desc': 'Kabel ditata tersembunyi untuk sirkulasi udara maksimal dan estetik.'}, {'icon': '🧪', 'title': 'Stress Test Benchmark', 'desc': 'Dipastikan bebas overheat dan bottleneck sebelum dikirim ke Anda.'}, {'icon': '🛡️', 'title': 'Garansi Tukar Baru', 'desc': 'Bantu klaim garansi part rusak langsung ke distributor tanpa ribet.'}];
---

<Layout title="Computer Center — PC Assembly & Hardware">
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        🖥️ Custom PC Assembly & Gaming Hardware
      </div>
      <h1 class="hero-title">RAKIT PC IMPUSANMU SESUAI BUDGET</h1>
      <p class="hero-desc">Dapatkan perakitan PC rapi professional, garansi komponen resmi hingga 3 tahun, tes stress benchmark 24 jam, dan konsultasi spesifikasi gratis.</p>
      
      <div style="display: flex; gap: 1rem; justify-content: center; align-items: center;">
        <a href="https://wa.me/6281234567890" class="btn-cta">
          Pesan Sekarang via WhatsApp
        </a>
        <a href="#katalog" style="padding: 0.75rem 1.5rem; border-radius: 99px; border: 1px solid var(--card-border); color: var(--text-main); font-weight: 600;">
          Lihat Katalog
        </a>
      </div>

      <div class="stats-grid">
        {stats.map((stat) => (
          <div class="stat-card">
            <div class="stat-val">{stat.val}</div>
            <div class="stat-lbl">{stat.lbl}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="katalog" class="catalog-section">
    <div class="container">
      <h2 class="section-title">PILAHAN PRODUK & LAYANAN UNGGULAN</h2>
      <div class="item-grid">
        {items.map((item) => (
          <div class="item-card">
            <div>
              <span class="item-tag">{item.tag}</span>
              <h3 class="item-name">{item.name}</h3>
              <p class="item-desc">{item.desc}</p>
            </div>
            <div class="item-footer">
              <span class="item-price">{item.price}</span>
              <a href="https://wa.me/6281234567890" style="color: var(--accent); font-weight: 700; font-size: 0.9rem;">Pesan &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="keunggulan" class="features-section">
    <div class="container">
      <h2 class="section-title">KENAPA RAKIT DI COMPUTER CENTER?</h2>
      <div class="features-grid">
        {features.map((feat) => (
          <div class="feature-card">
            <div class="feature-icon">{feat.icon}</div>
            <h3 class="feature-title">{feat.title}</h3>
            <p class="feature-desc">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
